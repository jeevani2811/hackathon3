# ==============================================================================
# OmniAgent Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual keys
# ==============================================================================

PROJECT_NAME="OmniAgent Intelligent Systems"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Option A: Direct Connection (Port 5432)
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# Option B: Transaction Pooler / PgBouncer (Port 6543) - Recommended
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
#
# Option C: Local SQLite Fallback (Runs automatically if Supabase is unconfigured)
DATABASE_URL="sqlite+aiosqlite:///backend/data/omniagent.db"

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT API CREDENTIALS
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_DB_PASSWORD="[YOUR-SUPABASE-PASSWORD]"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY="omniagent-super-secret-key-production-ready-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","*"]

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION ('mock', 'gemini', 'openai', 'anthropic')
# ------------------------------------------------------------------------------
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 6. AGENT EXECUTION BUDGETS & LIMITS
# ------------------------------------------------------------------------------
MAX_SUBTASKS=15
MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=300
AUTO_APPROVE_SAFE_TOOLS=true

# ------------------------------------------------------------------------------
# 7. ARTIFACT STORAGE
# ------------------------------------------------------------------------------
ARTIFACT_STORAGE_DIR="backend/data/artifacts"
