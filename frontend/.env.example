# ==============================================================================
# OmniAgent Frontend Environment Configuration Example
# Copy this file to frontend/.env and replace placeholders with your actual keys
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Supabase Client Configuration (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
